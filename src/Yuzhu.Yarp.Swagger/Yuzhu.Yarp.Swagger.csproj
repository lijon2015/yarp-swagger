<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <PackageId>Yuzhu.Yarp.Swagger</PackageId>
        <Version>2.0.1</Version>
        <Authors>Yuzhu</Authors>
        <Description>Swagger aggregation for YARP (Yet Another Reverse Proxy). Automatically discovers and aggregates Swagger documents from backend services using YARP metadata.</Description>
        <PackageProjectUrl>https://github.com/lijon2015/yarp-swagger</PackageProjectUrl>
        <PackageTags>yarp;swagger;openapi;reverse-proxy;api-gateway</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/lijon2015/yarp-swagger</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>
v2.0.1 — Code-style cleanup. No API or behavior changes.
 - Applied .editorconfig IDE rules across src/tests/sample (explicit types,
   expression bodies, primary constructors, collection expressions, discard
   unused expression values).
 - Converted two blocking-task calls in SwaggerDocumentCoordinatorTests to
   async/await (xUnit1031).
See CHANGELOG.md for details.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Yuzhu.Yarp.Swagger.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Duende.AccessTokenManagement" Version="4.2.0" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.7" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.7" />
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>

</Project>
